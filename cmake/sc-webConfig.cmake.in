@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# The libraries link LibXml2::LibXml2, found by CMake's own FindLibXml2.
find_dependency(LibXml2)
# ... and md4c::md4c (sc::web::markdown), from md4c's own md4cConfig.cmake.
find_dependency(md4c)

include("${CMAKE_CURRENT_LIST_DIR}/sc-webTargets.cmake")
